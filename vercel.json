{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "cleanUrls": true,
  "trailingSlash": false,
  "functions": {
    "api/proxy.js": {
      "maxDuration": 30
    },
    "api/poll.js": {
      "maxDuration": 60
    },
    "api/score.js": {
      "maxDuration": 60
    },
    "api/recommend.js": {
      "maxDuration": 60
    },
    "api/analyze.js": {
      "maxDuration": 60
    }
  },
  "rewrites": [
    { "source": "/api/yfin", "destination": "/api/proxy?__rota=yfin" },
    { "source": "/api/bildirim", "destination": "/api/proxy?__rota=bildirim" },

    { "source": "/api/tarama",   "destination": "/api/proxy?__rota=tarama" },
    { "source": "/api/sektor",   "destination": "/api/proxy?__rota=sektor" },
    { "source": "/api/radar",    "destination": "/api/proxy?__rota=radar" },
    { "source": "/api/backtest", "destination": "/api/proxy?__rota=backtest" },
    { "source": "/api/deger",    "destination": "/api/proxy?__rota=deger" },
    { "source": "/api/arama",    "destination": "/api/proxy?__rota=arama" },
    { "source": "/api/takvim",   "destination": "/api/proxy?__rota=takvim" },

    { "source": "/api/degisim",  "destination": "/api/proxy?__rota=degisim" },
    { "source": "/api/gundem",   "destination": "/api/proxy?__rota=gundem" },
    { "source": "/api/hareket", "destination": "/api/proxy?__rota=hareket" },
    { "source": "/api/iceriden", "destination": "/api/proxy?__rota=iceriden" },
    { "source": "/api/kripto",   "destination": "/api/proxy?__rota=kripto" },
    { "source": "/api/kur",      "destination": "/api/proxy?__rota=kur" },
    { "source": "/api/mali",     "destination": "/api/proxy?__rota=mali" },
    { "source": "/api/metal",    "destination": "/api/proxy?__rota=metal" },
    { "source": "/api/neden",    "destination": "/api/proxy?__rota=neden" },
    { "source": "/api/katalizor", "destination": "/api/proxy?__rota=katalizor" }
  ],
  "regions": ["fra1"],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" }
      ]
    }
  ]
}
