# =====================================================================
#  ORNEK ORTAM DOSYASI — gercek sir ICERMEZ          (FAZ 1 / native)
# ---------------------------------------------------------------------
#  NE: uygulamanin okudugu ortam degiskenlerinin LISTESI. Bu dosya
#  depoya girer; gercek degerler `.env.local` dosyasina yazilir ve o
#  dosya `.gitignore`da (`.env*.local`).
#
#  NEDEN `EXPO_PUBLIC_` ONEKI: Expo yalniz bu onekli degiskenleri
#  istemci paketine gomer. Oneksiz bir degisken native pakette
#  GORUNMEZ — yani burada "gizli" bir anahtar tutmak zaten mumkun
#  degil. Bu yuzden buraya YALNIZ herkese acik olabilen degerler
#  yazilir: servis adresi ve Supabase ANON anahtari.
#
#  NEDEN SERVICE_ROLE YOK: Supabase'in `service_role` anahtari tum
#  satirlari okur/yazar ve RLS'i atlar. Istemci paketine konuldugu an
#  veritabani herkese acilir. Sunucu tarafi isler icin o anahtar
#  Vercel ortam degiskenlerinde durur, bu dosyada ASLA yer almaz.
#
#  NEDEN DEGERLER BOS: bu depoda gercek Supabase projesi henuz yok.
#  Uydurma/ornek anahtar yazmak, "yapilandirildi" sanilmasina yol
#  acardi; uygulama bos degeri gorup durust "yapilandirilmadi"
#  durumuna duser (bkz. src/api/supabase.ts).
# =====================================================================

# Motor (Vercel) tabani. Bos birakilirsa kod icindeki varsayilan
# kullanilir: https://day-starter.vercel.app
EXPO_PUBLIC_API_URL=

# Supabase proje adresi — ornek bicim: https://<proje-ref>.supabase.co
EXPO_PUBLIC_SUPABASE_URL=

# Supabase ANON (publishable) anahtari. RLS ile korunur, pakette acik
# durmasi beklenir. `service_role` anahtarini BURAYA YAZMA.
EXPO_PUBLIC_SUPABASE_ANON_KEY=
